<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>mc.monacotelecom.buildfwk</groupId>
        <artifactId>parent</artifactId>
        <version>5.0.10</version>
    </parent>

    <groupId>mc.monacotelecom</groupId>
    <artifactId>services-management</artifactId>
    <version>2.29.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>services-management</name>
    <description>repository application to manage services</description>

    <properties>
        <docker.repository>monaco-telecom/ubi8-liquibase</docker.repository>
        <docker.tag>1.0.6</docker.tag>

        <common.version>1.1.39</common.version>
        <auth-lib.version>3.0.1</auth-lib.version>
        <bom-component.version>5.0.3</bom-component.version>
        <common-inventory.version>1.1.45</common-inventory.version>
        <liquibase-version>4.23.1</liquibase-version>

        <commons-csv.version>1.5</commons-csv.version>
        <javax-el.version>3.0.1-b12</javax-el.version>
        <jaxb-core.version>2.3.0.1</jaxb-core.version>
        <jaxb-api.version>2.3.1</jaxb-api.version>
        <jaxb-impl.version>2.3.1</jaxb-impl.version>

        <sonar.login>324061ee2162a6594e4b667e00529bb66f73e18c</sonar.login>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/../../${project.parent.artifactId}-report/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <modules>
        <module>services-management-service</module>
        <module>services-management-webservice</module>
        <module>services-management-domain</module>
        <module>services-management-process</module>
        <module>services-management-report</module>
        <module>services-management-dto</module>
        <module>services-management-client</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- SVC Dependencies -->
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>services-management-dto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>services-management-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>services-management-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>services-management-process</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal MT -->
            <dependency>
                <groupId>mc.monacotelecom.bom</groupId>
                <artifactId>bom-component</artifactId>
                <version>${bom-component.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>common-core</artifactId>
                <version>${common.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>common-restclient</artifactId>
                <version>${common.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>auth-lib</artifactId>
                <version>${auth-lib.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom</groupId>
                <artifactId>common-logs</artifactId>
                <version>${common.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-utils</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-nls</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-sm</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-audit</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-connectors</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-importer</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-importer-web</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-job</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-job-web</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>
            <dependency>
                <groupId>mc.monacotelecom.inventory</groupId>
                <artifactId>common-exporter</artifactId>
                <version>${common-inventory.version}</version>
            </dependency>

            <!-- External -->
            <dependency>
                <!-- Import dependency management from Spring Boot -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.statemachine</groupId>
                <artifactId>spring-statemachine-bom</artifactId>
                <version>${spring-statemachine.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.statemachine</groupId>
                <artifactId>spring-statemachine-starter</artifactId>
                <version>${spring-statemachine.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun.xml.bind</groupId>
                <artifactId>jaxb-core</artifactId>
                <version>${jaxb-core.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun.xml.bind</groupId>
                <artifactId>jaxb-impl</artifactId>
                <version>${jaxb-impl.version}</version>
            </dependency>
            <dependency>
                <groupId>org.glassfish</groupId>
                <artifactId>javax.el</artifactId>
                <version>${javax-el.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <dependency>
                <groupId>com.voodoodyne.jackson.jsog</groupId>
                <artifactId>jackson-jsog</artifactId>
                <version>${jackson-jsog.version}</version>
            </dependency>

            <!-- Keycloak -->
            <dependency>
                <groupId>org.keycloak</groupId>
                <artifactId>keycloak-spring-boot-starter</artifactId>
                <version>${keycloak.version}</version>
            </dependency>
            <dependency>
                <groupId>org.keycloak</groupId>
                <artifactId>keycloak-admin-client</artifactId>
                <version>${keycloak.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- To make @example@ properties resolvable in application.properties, to be used in
            common Swagger conf-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <configuration>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>
        </plugins>

        <!-- To make @example@ properties resolvable in application.properties, to be used in common
        Swagger conf-->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
