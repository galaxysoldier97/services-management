    <changeSet id="MTOSS-831-78-1" author="j.lethiec">
        <comment>Populate service_activation.activ_code with related activation code - first million
        </comment>
        <sql>
            update service_activation sa
                inner join (select service_id, activ_id
                from service_activation sa2
                order by service_id, activ_id
                limit 1000000 offset 0) as sa2 on sa.service_id = sa2.service_id and
                sa.activ_id = sa2.activ_id and sa.activ_code is null
                inner join activation_code ac
                on sa.activ_id = ac.id
                set sa.activ_code = ac.activ_code
            where sa.activ_code is null;
        </sql>
    </changeSet>

