    <changeSet id="GI-680-1" author="g.fantappie">
        <modifyDataType tableName="service_component" columnName="component_type"
                        newDataType="enum('TEAMS','CAS', 'CLOUDCALLING')"/>
    </changeSet>

    <changeSet id="GI-680-2" author="g.fantappie">
        <!--Update value CLOUDCALLING to TEAMS for aud table -->
        <update tableName="service_component">
            <column name="component_type" value="TEAMS"/>
            <where>component_type='CLOUDCALLING'</where>
        </update>
    </changeSet>

